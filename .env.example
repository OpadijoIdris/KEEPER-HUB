# --- Core (required from Phase 1) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keeperhub_platform?schema=public
JWT_ACCESS_SECRET=change-me-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-dev-only-too
JWT_REFRESH_TTL=7d

# --- KeeperHub Integration (introduced in Phase 2, optional until then) ---
KEEPERHUB_MCP_BASE_URL=https://app.keeperhub.com/mcp
KEEPERHUB_API_KEY=

# --- Wallet / Turnkey (introduced in Phase 2, optional until then) ---
KEEPERHUB_WALLET_SUB_ORG_ID=
KEEPERHUB_WALLET_HMAC_SECRET=
