# --- Core (required from Phase 1) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Local dev default: Dockerized Postgres from docker-compose.yml (port 5433, avoids
# clashing with any local Postgres install). Run `npm run docker:up` first, or point
# this at a native local Postgres on 5432 if you prefer.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/keeperhub_platform?schema=public
JWT_ACCESS_SECRET=change-me-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-dev-only-too
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173

# --- KeeperHub Integration ---
KEEPERHUB_MCP_BASE_URL=https://app.keeperhub.com/mcp
KEEPERHUB_API_KEY=

# --- Wallet (not read by the app itself — every agent links its own wallet via
# PATCH /agents/:agentId/wallet, see README.md "Wallet model". These two are only
# used by scripts/seed-demo.ts as a convenient known-good wallet for demo agents.) ---
KEEPERHUB_WALLET_ADDRESS=
KEEPERHUB_WALLET_INTEGRATION_ID=

# --- AI (Oxlo.ai, OpenAI-compatible — see docs.oxlo.ai) ---
OXLO_BASE_URL=https://api.oxlo.ai/v1
OXLO_API_KEY=
OXLO_MODEL=deepseek-r1-8b

# --- Notifications (email delivery via Nodemailer/SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
